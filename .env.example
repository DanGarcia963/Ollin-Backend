# Configurar en Railway > Ollin-Backend > Variables.
# No subir valores secretos reales al repositorio.
NODE_ENV=production
FRONTEND_URL=https://ollin-tu-camino.netlify.app
BACKEND_URL=https://ollin-backend-production-46550904.up.railway.app
JWT_SECRET=
JWT_EXPIRATION=1h
GMAPS_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER=
MAILJET_SEND_NAME=Ollin

# Opcionales hasta definir cuál proyecto de Supabase contiene los datos.
# Sin estas variables, se conserva la conexión que ya está en el repositorio.
# Al configurar otra base, establece ambas juntas en Railway.
# SUPABASE_URL=https://TU_PROYECTO.supabase.co
# SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICABLE
